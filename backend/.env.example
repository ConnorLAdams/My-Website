# Copy this file to `.env.local` (backend/.env.local) and fill in real values.
# `.env.local` and `.env` are gitignored so your secrets stay out of version control.
# See docs/contact-form.md for the full setup guide.

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that should receive contact-form submissions (an address you control).
CONTACT_TO_EMAIL=connor@connoradams.io

# Verified sender on your Resend domain (connoradams.io). Optional —
# defaults to "Portfolio Contact <contact@connoradams.io>".
CONTACT_FROM_EMAIL=Portfolio Contact <contact@connoradams.io>
